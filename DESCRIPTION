Package: brfutures
Type: Package
Title: Brazilian Futures Data Tools
Version: 0.0.4
Authors@R: person(
    given = "Hugo",
    family = "Rzepian Teixeira",
    email = "hugorteixeira@senhormercado.com.br",
    role = c("aut", "cre"))
Description: Lightweight tools to download, parse, cache, and retrieve B3
    (BM&F Bovespa) futures daily bulletins from the legacy HTML endpoint and
    the BVBG XML reports (using the complete PR/BVBG.086 price report),
    switching automatically at a configurable cutover date. Provides update
    helpers that keep a hash-verified local cache in sync and fast accessors for
    cached contract data.
License: GPL (>= 3)
Depends:
    R (>= 3.5.0)
Encoding: UTF-8
Imports:
    FinancialInstrument,
    lubridate,
    digest,
    httr,
    xml2,
    rvest,
    xts,
    tibble,
    bizdays,
    positionsizer,
    zoo
Suggests:
